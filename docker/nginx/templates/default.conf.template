# 前端站点配置模板。由 docker/nginx/docker-entrypoint.d/10-nacos-config.sh 渲染成
# /etc/nginx/conf.d/default.conf —— 里面三个 ${...} 的值全部来自**配置中心**，不写死在这里。
#
# 渲染用的是 envsubst 且**显式限定变量名**，只替换下面这三个；
# nginx 自己的运行时变量（$uri、$proxy_host、$remote_addr…）原样保留 ——
# 不限定的话它们会被 envsubst 当成环境变量、统统替换成空串。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 便于确认「这个容器读的是哪个环境的配置、把请求转到了哪里」：
    #   curl -I http://127.0.0.1:5300/
    # 注意 add_header 的作用域规则：下面两个 location 都没有自己的 add_header，
    # 所以它们会继承这两行；一旦哪个 location 里写了 add_header，就得自己再写一遍。
    add_header X-Frontend-Env "${FRONTEND_ENV_LABEL}" always;
    add_header X-Backend-Origin "${BACKEND_ORIGIN}" always;

    # SPA 路由：/user、/home 这类路径在磁盘上没有对应文件，
    # 直接 404 会让人以为部署失败，所以统一回落到 index.html 交给 vue-router。
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端调用：/api/** **原样**转发到配置中心给的地址（保留 /api 前缀）。
    # 网关的对外路由本来就是 /api/user/**，去掉前缀由网关自己的 StripPrefix 负责，
    # 所以这里绝不能再 rewrite 一次。
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout ${FRONTEND_PROXY_TIMEOUT}s;
        proxy_send_timeout ${FRONTEND_PROXY_TIMEOUT}s;
    }
}